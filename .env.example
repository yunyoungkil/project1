# YouTube Data API v3 key (also reused for Gemini if GEMINI_API_KEY is unset)
YOUTUBE_API_KEY=

# OAuth client for YouTube Analytics API (my channel data). Used by `research auth`.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: dedicated Gemini API key. Falls back to YOUTUBE_API_KEY if unset.
GEMINI_API_KEY=
